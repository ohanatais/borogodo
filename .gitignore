.claude/auth.json
.claude/.credentials
.claude/settings.local.json

# Claude Code — skills/agents de terceiros: ferramenta local, não versionar
.claude/skills/
.claude/agents/

# typescript
*.tsbuildinfo
next-env.d.ts

# dados pessoais / fixtures sensíveis — NUNCA commitar (usar só anonimizado em docs/fixtures)
/Ohana Lohmann - *.md
/Profile*.pdf

# Worktrees do Claude Code (cada uma é um checkout próprio; não rastrear)
.claude/worktrees/
